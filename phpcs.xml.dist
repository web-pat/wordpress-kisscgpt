<?xml version="1.0"?>
<ruleset name="Direct OpenAI Article Generator">
    <description>WordPress standards and PHP 8.1 compatibility.</description>
    <file>direct-openai-article-generator.php</file>
    <file>includes</file>
    <file>admin</file>
    <file>uninstall.php</file>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <config name="testVersion" value="8.1-"/>
    <config name="minimum_supported_wp_version" value="6.7"/>
    <rule ref="WordPress">
        <!-- Types are native PHP; prose documentation is kept on public boundaries. -->
        <exclude name="Squiz.Commenting.FunctionComment"/>
        <exclude name="Squiz.Commenting.VariableComment"/>
        <exclude name="Squiz.Commenting.ClassComment"/>
        <exclude name="Squiz.Commenting.FileComment"/>
    </rule>
    <rule ref="PHPCompatibilityWP"/>
    <rule ref="WordPress.WP.I18n">
        <properties><property name="text_domain" type="array"><element value="direct-openai-article-generator"/></property></properties>
    </rule>
</ruleset>
